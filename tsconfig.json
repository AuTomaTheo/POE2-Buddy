{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "vitest.config.mts",
    "vitest.pob2.config.mts",
    "tests/**/*.ts",
    "scripts/**/*.ts"
  ]
}
