{
  "name": "poe2-helper",
  "version": "0.1.0",
  "private": true,
  "description": "PoE2 Helper — deterministic Path of Exile 2 build helper",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "start": "npm run start -w web",
    "lint": "npm run lint -w web",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck -w web",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^20",
    "prettier": "^3.6.2",
    "typescript": "^5",
    "vitest": "4.1.11"
  }
}
