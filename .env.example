# Placeholder names only. Do not put real secrets in this file.
# None of these are required for the fixture-based MVP.
# GGG OAuth credentials are not available yet. Leave them empty.
# The live authorization routes stay disabled until GGG_LIVE_IMPORT=enabled as well.
# Copy this file to apps/web/.env.local only after Grinding Gear Games issues a real value.
# Next.js reads environment files from apps/web, not from the repository root.

GGG_CLIENT_ID=
GGG_CLIENT_SECRET=
GGG_REDIRECT_URI=

# Set to enabled only after Grinding Gear Games issues a client and the live path is reviewed.
# Any other value, including empty, keeps live authorization disabled.
GGG_LIVE_IMPORT=

# Contact sent in the GGG User-Agent. Required before a live character request. Not a secret.
GGG_CONTACT=

# Optional later. The application must run without an LLM provider.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Optional. Public repository downloads do not need a token.
GITHUB_TOKEN=

# Contact included in the poe.ninja User-Agent. Required before /api/economy calls poe.ninja.
# Example shape after you copy this file: name or email the provider can use to reach you.
POE2_NINJA_CONTACT=

# Directory that contains the pinned passive-tree manifest.json and data.json.
# Development may point this at docs/data-snapshots/passive-tree.
# Production must set a deployed data directory. The docs folder is not a runtime default.
POE2_PASSIVE_TREE_SNAPSHOT_DIR=

# Character-aware deltas. Empty or any value other than true keeps the calculator off.
# The app still shows heuristic results. Set the directory to an isolated runtime copy
# created by scripts/prepare-pob2-runtime.mjs. Never point this at the live PoB2 install.
POB2_CALCULATOR_ENABLED=
POB2_CALCULATOR_DIR=
