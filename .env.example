# Placeholder names only. Do not put real secrets in this file.
# None of these are required for the fixture-based MVP.
# GGG OAuth credentials are not available yet.
# Copy this file to apps/web/.env.local only after a real value is issued.
# Next.js reads environment files from apps/web, not from the repository root.

GGG_CLIENT_ID=
GGG_CLIENT_SECRET=
GGG_REDIRECT_URI=

# Optional later. The application must run without an LLM provider.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Optional. Public repository downloads do not need a token.
GITHUB_TOKEN=
